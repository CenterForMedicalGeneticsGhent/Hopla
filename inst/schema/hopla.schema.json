{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/CenterForMedicalGeneticsGhent/Hopla/hopla.schema.json",
  "title": "Hopla settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_ids"],
  "properties": {
    "sample_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "father_ids": {"type": "array", "items": {"type": ["string", "null"]}},
    "mother_ids": {"type": "array", "items": {"type": ["string", "null"]}},
    "genders": {"type": "array", "items": {"enum": ["M", "F", null]}},
    "run_merlin": {"type": "boolean", "default": true},
    "cytoband_file": {"type": "string"},
    "dp_hard_limit_ids": {"type": "array", "items": {"type": "string"}},
    "dp_hard_limit": {"type": "number", "minimum": 0, "default": 10},
    "af_hard_limit_ids": {"type": "array", "items": {"type": "string"}},
    "af_hard_limit": {"type": "number", "minimum": 0, "exclusiveMaximum": 1, "default": 0},
    "dp_soft_limit_ids": {"type": "array", "items": {"type": "string"}},
    "dp_soft_limit": {"type": "number", "minimum": 0, "default": 10},
    "keep_informative_ids": {"type": "array", "maxItems": 2, "items": {"type": "string"}},
    "keep_hetero_ids": {"type": "array", "items": {"type": "string"}},
    "regions": {"type": "array", "items": {"type": "string", "pattern": "^chr[^:]+:[0-9]+-[0-9]+$"}},
    "reference_ids": {"type": "array", "items": {"type": "string"}},
    "carrier_ids": {"type": "array", "items": {"type": "string"}},
    "affected_ids": {"type": "array", "items": {"type": "string"}},
    "nonaffected_ids": {"type": "array", "items": {"type": "string"}},
    "info": {"type": "array", "items": {"type": "string"}},
    "baf_ids": {"type": "array", "items": {"type": "string"}},
    "merlin_model": {"type": "string", "enum": ["sample", "best"], "default": "best"},
    "min_seg_var": {"type": "number", "minimum": 0, "default": 5},
    "min_seg_var_x": {"type": "number", "minimum": 0, "default": 15},
    "window_size_voting": {"type": "number", "minimum": 0, "default": 10000000},
    "window_size_voting_x": {"type": "number", "minimum": 0},
    "keep_chromosomes_only": {"type": "boolean", "default": true},
    "keep_regions_only": {"type": "boolean", "default": false},
    "concordance_table": {"type": "boolean", "default": true},
    "fam_id": {"type": "string", "minLength": 1, "default": "hopla"},
    "x_cutoff": {"type": "number", "default": 1.5},
    "y_cutoff": {"type": "number", "default": 0.6},
    "window_size": {"type": "number", "exclusiveMinimum": 0, "default": 1000000},
    "regions_flanking_size": {"type": "number", "minimum": 0, "default": 2000000},
    "limit_baf_to_p": {"type": "boolean", "default": false},
    "limit_pm_to_p": {"type": "boolean", "default": false},
    "value_of_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.25},
    "color_palette": {"type": "string", "default": "Paired"},
    "dot_factor": {"type": "number", "exclusiveMinimum": 0, "default": 2},
    "self_contained": {"type": "boolean", "default": false},
    "cairo": {"type": "boolean", "default": false}
  }
}
