{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/CenterForMedicalGeneticsGhent/Hopla/hopla.schema.json",
  "title": "Hopla settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["vcf.file", "sample.ids"],
  "properties": {
    "vcf.file": {"type": "string", "minLength": 1},
    "sample.ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "father.ids": {"type": "array", "items": {"type": ["string", "null"]}},
    "mother.ids": {"type": "array", "items": {"type": ["string", "null"]}},
    "genders": {"type": "array", "items": {"enum": ["M", "F", null]}},
    "run.merlin": {"type": "boolean", "default": true},
    "cytoband.file": {"type": "string"},
    "dp.hard.limit.ids": {"type": "array", "items": {"type": "string"}},
    "dp.hard.limit": {"type": "number", "minimum": 0, "default": 10},
    "af.hard.limit.ids": {"type": "array", "items": {"type": "string"}},
    "af.hard.limit": {"type": "number", "minimum": 0, "exclusiveMaximum": 1, "default": 0},
    "dp.soft.limit.ids": {"type": "array", "items": {"type": "string"}},
    "dp.soft.limit": {"type": "number", "minimum": 0, "default": 10},
    "keep.informative.ids": {"type": "array", "maxItems": 2, "items": {"type": "string"}},
    "keep.hetero.ids": {"type": "array", "items": {"type": "string"}},
    "regions": {"type": "array", "items": {"type": "string", "pattern": "^chr[^:]+:[0-9]+-[0-9]+$"}},
    "reference.ids": {"type": "array", "items": {"type": "string"}},
    "carrier.ids": {"type": "array", "items": {"type": "string"}},
    "affected.ids": {"type": "array", "items": {"type": "string"}},
    "nonaffected.ids": {"type": "array", "items": {"type": "string"}},
    "info": {"type": "array", "items": {"type": "string"}},
    "baf.ids": {"type": "array", "items": {"type": "string"}},
    "merlin.model": {"type": "string", "enum": ["sample", "best"], "default": "best"},
    "min.seg.var": {"type": "number", "minimum": 0, "default": 5},
    "min.seg.var.X": {"type": "number", "minimum": 0, "default": 15},
    "window.size.voting": {"type": "number", "minimum": 0, "default": 10000000},
    "window.size.voting.X": {"type": "number", "minimum": 0},
    "keep.chromosomes.only": {"type": "boolean", "default": true},
    "keep.regions.only": {"type": "boolean", "default": false},
    "concordance.table": {"type": "boolean", "default": true},
    "out.dir": {"type": "string", "default": "./"},
    "fam.id": {"type": "string", "minLength": 1, "default": "hopla"},
    "X.cutoff": {"type": "number", "default": 1.5},
    "Y.cutoff": {"type": "number", "default": 0.6},
    "window.size": {"type": "number", "exclusiveMinimum": 0, "default": 1000000},
    "regions.flanking.size": {"type": "number", "minimum": 0, "default": 2000000},
    "limit.baf.to.P": {"type": "boolean", "default": false},
    "limit.pm.to.P": {"type": "boolean", "default": false},
    "value.of.P": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.25},
    "color.palette": {"type": "string", "default": "Paired"},
    "dot.factor": {"type": "number", "exclusiveMinimum": 0, "default": 2},
    "self.contained": {"type": "boolean", "default": false},
    "cairo": {"type": "boolean", "default": false}
  }
}
