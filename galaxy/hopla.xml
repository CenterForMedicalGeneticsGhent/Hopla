<tool id="hopla" name="Hopla" version="3.0.0+galaxy0" profile="23.0">
    <description>run genomic family analysis or convert legacy settings</description>
    <requirements>
        <container type="docker">quay.io/cmgg/hopla:3.0.0</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
set -eu
#if str($operation.subcommand) == 'run'
    #if str($operation.vcf_input.input_type) == 'vcf'
ln -s '$operation.vcf_input.vcf' input.vcf &&
vcf_path='input.vcf'
    #else
ln -s '$operation.vcf_input.vcf_bgzip' input.vcf.gz &&
vcf_path='input.vcf.gz'
        #if str($operation.vcf_input.index_input.index_type) != 'none'
            #if str($operation.vcf_input.index_input.index_type) == 'csi'
ln -s '$operation.vcf_input.index_input.index' input.vcf.gz.csi &&
            #else
ln -s '$operation.vcf_input.index_input.index' input.vcf.gz.tbi &&
            #end if
        #end if
    #end if
report_path="$(
    hopla -L '$log_level' run \
        -o . \
        -t "\${GALAXY_SLOTS:-1}" \
        #if $operation.cytoband
        -c '$operation.cytoband' \
        #end if
        #if $operation.export_parquet
        --export-parquet \
        #end if
        #if $operation.export_bigwig
        --export-bigwig \
        #end if
        '$operation.settings' \
        "\$vcf_path"
)" &&
mv "\$report_path" '$run_report'
    #if $operation.export_parquet or $operation.export_bigwig
export_dir="\${report_path%-output.html}-export" &&
tar -czf '$run_exports' -C "\$export_dir" .
    #end if
#else
hopla -L '$log_level' convert '$operation.legacy' '$converted_settings'
#end if
    ]]></command>
    <inputs>
        <param name="log_level" type="select" label="Log level">
            <option value="error">Error</option>
            <option value="warn">Warning</option>
            <option value="info" selected="true">Information</option>
            <option value="debug">Debug</option>
        </param>
        <conditional name="operation">
            <param name="subcommand" type="select" label="Operation">
                <option value="run" selected="true">Run family analysis</option>
                <option value="convert">Convert legacy settings</option>
            </param>
            <when value="run">
                <param name="settings" type="data" format="yaml,json" label="Analysis settings" />
                <conditional name="vcf_input">
                    <param name="input_type" type="select" label="VCF compression">
                        <option value="vcf" selected="true">Uncompressed VCF</option>
                        <option value="vcf_bgzip">bgzip-compressed VCF</option>
                    </param>
                    <when value="vcf">
                        <param name="vcf" type="data" format="vcf" label="VCF" />
                    </when>
                    <when value="vcf_bgzip">
                        <param name="vcf_bgzip" type="data" format="vcf_bgzip"
                               label="bgzip-compressed VCF" />
                        <conditional name="index_input">
                            <param name="index_type" type="select" label="VCF index">
                                <option value="none" selected="true">No index</option>
                                <option value="tabix">Tabix index (.tbi)</option>
                                <option value="csi">CSI index (.csi)</option>
                            </param>
                            <when value="none" />
                            <when value="tabix">
                                <param name="index" type="data" format="tabix"
                                       label="Tabix index" />
                            </when>
                            <when value="csi">
                                <param name="index" type="data" format="data"
                                       label="CSI index"
                                       help="Galaxy 23.0 has no standalone CSI history datatype; upload the .csi file as generic data." />
                            </when>
                        </conditional>
                    </when>
                </conditional>
                <param name="cytoband" type="data" format="tabular,txt" optional="true"
                       label="UCSC hg38 cytoband table"
                       help="If omitted, Hopla downloads the hg38 table from UCSC." />
                <param name="export_parquet" type="boolean" checked="false"
                       label="Export portable Parquet tables" />
                <param name="export_bigwig" type="boolean" checked="false"
                       label="Export IGV tracks" />
            </when>
            <when value="convert">
                <param name="legacy" type="data" format="txt"
                       label="Legacy key=value settings" />
            </when>
        </conditional>
    </inputs>
    <outputs>
        <data name="run_report" format="html" label="${tool.name} report">
            <filter>operation['subcommand'] == 'run'</filter>
        </data>
        <data name="run_exports" format="tgz" label="${tool.name} exports">
            <filter>operation['subcommand'] == 'run'</filter>
            <filter>operation['export_parquet'] or operation['export_bigwig']</filter>
        </data>
        <data name="converted_settings" format="yaml" label="${tool.name} converted settings">
            <filter>operation['subcommand'] == 'convert'</filter>
        </data>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="log_level" value="info" />
            <conditional name="operation">
                <param name="subcommand" value="run" />
                <param name="settings" value="settings.yaml" />
                <conditional name="vcf_input">
                    <param name="input_type" value="vcf" />
                    <param name="vcf" value="family.vcf" />
                </conditional>
                <param name="cytoband" value="cytoband.hg38.txt" />
                <param name="export_parquet" value="false" />
                <param name="export_bigwig" value="false" />
            </conditional>
            <output name="run_report">
                <assert_contents>
                    <has_text text="galaxy.test" />
                    <has_text text="FATHER" />
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="log_level" value="info" />
            <conditional name="operation">
                <param name="subcommand" value="run" />
                <param name="settings" value="settings.yaml" />
                <conditional name="vcf_input">
                    <param name="input_type" value="vcf_bgzip" />
                    <param name="vcf_bgzip" value="family.vcf.gz" />
                    <conditional name="index_input">
                        <param name="index_type" value="tabix" />
                        <param name="index" value="family.vcf.gz.tbi" />
                    </conditional>
                </conditional>
                <param name="cytoband" value="cytoband.hg38.txt" />
                <param name="export_parquet" value="false" />
                <param name="export_bigwig" value="false" />
            </conditional>
            <output name="run_report">
                <assert_contents>
                    <has_text text="galaxy.test" />
                    <has_text text="FATHER" />
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="log_level" value="info" />
            <conditional name="operation">
                <param name="subcommand" value="convert" />
                <param name="legacy" value="legacy-settings.txt" />
            </conditional>
            <output name="converted_settings" file="converted-settings.yaml" />
        </test>
    </tests>
    <help><![CDATA[
**Hopla**

Hopla analyzes a multisample family VCF from schema-validated YAML or JSON
settings and writes a self-contained interactive HTML report. It can also
convert historical ``key=value`` settings to YAML.

For compressed input, select **bgzip-compressed VCF** and optionally supply its
tabix or CSI index. Indexed VCFs can use all Galaxy job slots; unindexed VCFs
fall back to a sequential scan.

The report requires JavaScript. Galaxy administrators must add the ``hopla``
tool id to ``sanitize_allowlist.txt`` (or configure the equivalent
``sanitize_allowlist_file`` setting) so Galaxy serves the report without HTML
sanitization.
    ]]></help>
    <citations>
        <citation type="bibtex">@misc{hopla,
  title = {Hopla},
  author = {Center for Medical Genetics Ghent},
  url = {https://github.com/CenterForMedicalGeneticsGhent/Hopla}
}</citation>
    </citations>
</tool>
