<tool id="hopla3" name="Hopla 3" version="3.0.0+galaxy0" profile="23.0">
    <description>genomic family analysis with an interactive HTML report</description>
    <requirements>
        <container type="docker">quay.io/cmgg/hopla:3.0.0</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
#set $vcf_path = 'input.vcf.gz' if $vcf.is_of_type('vcf_bgzip') else 'input.vcf'
ln -s '$vcf' '$vcf_path' &&
#if $vcf.is_of_type('vcf_bgzip')
ln -s '$vcf.metadata.tabix_index' '${vcf_path}.tbi' &&
#end if
hopla -L debug run
-t \${GALAXY_SLOTS:-1}
#if $cytoband
-c '$cytoband'
#end if
$export_parquet $export_bigwig
'$settings' '$vcf_path' &&
mv *-output.html '$report'
#if $export_parquet or $export_bigwig
&& tar -czf '$exports' *-export
#end if
    ]]></command>
    <inputs>
        <param name="settings" type="data" format="yaml,json" label="Analysis settings"/>
        <param name="vcf" type="data" format="vcf,vcf_bgzip" label="Family VCF"/>
        <param name="cytoband" type="data" format="tabular,txt" optional="true" label="UCSC hg38 cytoband table" help="Downloaded from UCSC when omitted."/>
        <param name="export_parquet" type="boolean" truevalue="--export-parquet" falsevalue="" checked="false" label="Export portable Parquet tables"/>
        <param name="export_bigwig" type="boolean" truevalue="--export-bigwig" falsevalue="" checked="false" label="Export IGV tracks"/>
    </inputs>
    <outputs>
        <data name="report" format="html" label="${tool.name} on ${on_string}: report"/>
        <data name="exports" format="tgz" label="${tool.name} on ${on_string}: exports">
            <filter>export_parquet or export_bigwig</filter>
        </data>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="settings" value="settings.yaml" ftype="yaml"/>
            <param name="vcf" value="family.vcf" ftype="vcf"/>
            <param name="cytoband" value="cytoband.hg38.txt" ftype="tabular"/>
            <output name="report">
                <assert_contents>
                    <has_text text="galaxy.test"/>
                    <has_text text="FATHER"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="settings" value="settings.yaml" ftype="yaml"/>
            <param name="vcf" value="family.vcf.gz" ftype="vcf_bgzip"/>
            <param name="cytoband" value="cytoband.hg38.txt" ftype="tabular"/>
            <output name="report">
                <assert_contents>
                    <has_text text="galaxy.test"/>
                    <has_text text="FATHER"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="2">
            <param name="settings" value="settings.yaml" ftype="yaml"/>
            <param name="vcf" value="family.vcf" ftype="vcf"/>
            <param name="cytoband" value="cytoband.hg38.txt" ftype="tabular"/>
            <param name="export_parquet" value="true"/>
            <output name="report">
                <assert_contents>
                    <has_text text="galaxy.test"/>
                </assert_contents>
            </output>
            <output name="exports">
                <assert_contents>
                    <has_size min="1"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
**Hopla**

Hopla analyzes a multisample family VCF from schema-validated YAML or JSON
settings and writes a self-contained interactive HTML report.

A bgzip-compressed VCF is read per contig with all allocated job slots, using
the tabix index Galaxy keeps for the dataset. An uncompressed VCF is scanned
sequentially.

The report requires JavaScript. Galaxy administrators must add the ``hopla3``
tool id to the file configured by ``sanitize_allowlist_file`` so Galaxy serves
the report without HTML sanitization.
    ]]></help>
    <citations>
        <citation type="bibtex">@misc{hopla,
  title = {Hopla},
  author = {Center for Medical Genetics Ghent},
  url = {https://github.com/CenterForMedicalGeneticsGhent/Hopla}
}</citation>
    </citations>
</tool>
