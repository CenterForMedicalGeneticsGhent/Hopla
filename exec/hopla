#!/usr/bin/env Rscript

script_arg <- grep("^--file=", commandArgs(trailingOnly = FALSE), value = TRUE)
script_file <- if (length(script_arg)) sub("^--file=", "", script_arg[1]) else "exec/hopla"
package_root <- normalizePath(file.path(dirname(script_file), ".."), mustWork = FALSE)
development_source <- file.path(package_root, "R", "hopla.R")

if (file.exists(development_source)) {
  source(development_source)
  version <- read.dcf(file.path(package_root, "DESCRIPTION"), fields = "Version")[1]
} else {
  suppressPackageStartupMessages(library(hopla))
  version <- as.character(utils::packageVersion("hopla"))
}

usage <- function() {
  cat(
    "Usage:\n",
    "  hopla [-hV] [--] run [-o OUT_DIR] SETTINGS.{yaml,yml,json} VCF\n",
    "  hopla [-hV] [--] convert LEGACY [OUTPUT]\n",
    "  hopla [-hV] [--] concordance [-r] FLOW1 FLOW2\n",
    "  hopla [-hV] [--] transform FLOW1 FLOW2 MODE [OUTPUT]\n\n",
    "MODE is 1 for matching strands or 2 for crossed strands.\n",
    "OUT_DIR defaults to the current working directory.\n",
    sep = ""
  )
}

usage_error <- function(message) {
  cat("ERROR: ", message, "\n", file = stderr(), sep = "")
  usage()
  quit(status = 2)
}

runtime_error <- function(message) {
  cat("ERROR: ", message, "\n", file = stderr(), sep = "")
  quit(status = 1)
}

show_version <- function() {
  cat("v", version, "\n", sep = "")
  quit(status = 0)
}

show_help <- function() {
  usage()
  quit(status = 0)
}

remaining_operands <- function(args, index) {
  if (index > length(args)) character() else args[index:length(args)]
}

after_option_terminator <- function(args, index) {
  remaining_operands(args, index + 1L)
}

parse_short_options <- function(token, allow_relative = FALSE, relative = FALSE) {
  options <- strsplit(sub("^-", "", token), "", fixed = TRUE)[[1]]
  for (option in options) {
    if (option == "h") show_help()
    if (option == "V") show_version()
    if (option == "r" && allow_relative) {
      relative <- TRUE
      next
    }
    usage_error(paste0("unknown option: -", option))
  }
  relative
}

parse_global_options <- function(args) {
  index <- 1L
  while (index <= length(args)) {
    token <- args[[index]]
    if (token == "--") {
      return(list(operands = after_option_terminator(args, index)))
    }
    if (token == "--help") show_help()
    if (token == "--version") show_version()
    if (startsWith(token, "--")) usage_error(paste0("unknown option: ", token))
    if (startsWith(token, "-") && token != "-") {
      parse_short_options(token)
      index <- index + 1L
      next
    }
    break
  }
  list(operands = remaining_operands(args, index))
}

parse_concordance_options <- function(args) {
  relative <- FALSE
  index <- 1L
  while (index <= length(args)) {
    token <- args[[index]]
    if (token == "--") {
      return(list(relative = relative, operands = after_option_terminator(args, index)))
    }
    if (token == "--help") show_help()
    if (token == "--version") show_version()
    if (startsWith(token, "--")) usage_error(paste0("unknown option: ", token))
    if (startsWith(token, "-") && token != "-") {
      relative <- parse_short_options(token, allow_relative = TRUE, relative = relative)
      index <- index + 1L
      next
    }
    break
  }
  list(relative = relative, operands = remaining_operands(args, index))
}

parse_transform_options <- function(args) {
  index <- 1L
  while (index <= length(args)) {
    token <- args[[index]]
    if (token == "--") {
      return(list(operands = after_option_terminator(args, index)))
    }
    if (token == "--help") show_help()
    if (token == "--version") show_version()
    if (startsWith(token, "--")) usage_error(paste0("unknown option: ", token))
    if (startsWith(token, "-") && token != "-") {
      parse_short_options(token)
      index <- index + 1L
      next
    }
    break
  }
  list(operands = remaining_operands(args, index))
}

parse_convert_options <- function(args) {
  index <- 1L
  while (index <= length(args)) {
    token <- args[[index]]
    if (token == "--") {
      return(list(operands = after_option_terminator(args, index)))
    }
    if (token == "--help") show_help()
    if (token == "--version") show_version()
    if (startsWith(token, "--")) usage_error(paste0("unknown option: ", token))
    if (startsWith(token, "-") && token != "-") {
      parse_short_options(token)
      index <- index + 1L
      next
    }
    break
  }
  list(operands = remaining_operands(args, index))
}

parse_run_options <- function(args) {
  out_dir <- getwd()
  index <- 1L
  while (index <= length(args)) {
    token <- args[[index]]
    if (token == "--") {
      return(list(out_dir = out_dir, operands = after_option_terminator(args, index)))
    }
    if (token == "--help") show_help()
    if (token == "--version") show_version()
    if (token == "-o") {
      if (index == length(args)) {
        usage_error("missing value for -o.")
      }
      out_dir <- args[[index + 1L]]
      index <- index + 2L
      next
    }
    if (startsWith(token, "--")) usage_error(paste0("unknown option: ", token))
    if (startsWith(token, "-o") && nchar(token) > 2L) {
      out_dir <- substring(token, 3L)
      index <- index + 1L
      next
    }
    if (startsWith(token, "-") && token != "-") {
      parse_short_options(token)
      index <- index + 1L
      next
    }
    break
  }
  list(out_dir = out_dir, operands = remaining_operands(args, index))
}

args <- commandArgs(trailingOnly = TRUE)
if (!length(args)) {
  usage_error("missing subcommand.")
}

parsed <- parse_global_options(args)
args <- parsed$operands
if (!length(args)) {
  usage_error("missing subcommand.")
}

subcommand <- args[[1]]
operands <- args[-1]

status <- tryCatch({
  switch(
    subcommand,
    run = {
      parsed_run <- parse_run_options(operands)
      run_operands <- parsed_run$operands
      if (length(run_operands) != 2L) {
        usage_error("run expects a settings file and a VCF file.")
      }
      engine_status <- hopla_run(
        run_operands[[1]],
        run_operands[[2]],
        parsed_run$out_dir,
        file.path(package_root, "exec", "hopla-run.R")
      )
      if (!is.null(engine_status) && is.numeric(engine_status) && engine_status != 0L) {
        quit(status = as.integer(engine_status))
      }
      0L
    },
    concordance = {
      parsed_concordance <- parse_concordance_options(operands)
      concordance_operands <- parsed_concordance$operands
      if (length(concordance_operands) != 2L) {
        usage_error("concordance expects two flow tables.")
      }
      values <- hopla_concordance(
        concordance_operands[[1]],
        concordance_operands[[2]],
        relative = parsed_concordance$relative
      )
      first <- sub("-.*$", "", basename(concordance_operands[[1]]))
      second <- sub("-.*$", "", basename(concordance_operands[[2]]))
      labels <- c(
        paste0(first, "-1 vs ", second, "-1"),
        paste0(first, "-1 vs ", second, "-2"),
        paste0(first, "-2 vs ", second, "-1"),
        paste0(first, "-2 vs ", second, "-2")
      )
      cat(paste0(labels, ": ", values, "%\n"), sep = "")
      0L
    },
    convert = {
      parsed_convert <- parse_convert_options(operands)
      convert_operands <- parsed_convert$operands
      if (!(length(convert_operands) %in% 1:2)) {
        usage_error("convert expects a legacy settings file and optional OUTPUT.")
      }
      schema_candidates <- c(
        file.path(package_root, "inst", "schema", "hopla.schema.json"),
        file.path(package_root, "schema", "hopla.schema.json")
      )
      schema_file <- schema_candidates[file.exists(schema_candidates)][1]
      if (!length(schema_file) || is.na(schema_file)) {
        schema_file <- NULL
      }
      output <- if (length(convert_operands) == 2L) convert_operands[[2]] else NULL
      hopla_convert_settings(convert_operands[[1]], output, schema_file)
      0L
    },
    transform = {
      parsed_transform <- parse_transform_options(operands)
      transform_operands <- parsed_transform$operands
      if (!(length(transform_operands) %in% 3:4)) {
        usage_error("transform expects two flow tables, MODE, and optional OUTPUT.")
      }
      output <- if (length(transform_operands) == 4L) transform_operands[[4]] else NULL
      hopla_transform(
        transform_operands[[1]],
        transform_operands[[2]],
        transform_operands[[3]],
        output
      )
      0L
    },
    usage_error(paste0("unknown subcommand: ", subcommand))
  )
}, error = function(error) {
  cat("ERROR: ", conditionMessage(error), "\n", file = stderr(), sep = "")
  1L
})

quit(status = status)
